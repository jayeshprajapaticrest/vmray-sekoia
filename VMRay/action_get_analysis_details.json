{
  "name": "Get analysis details",
  "description": "Fetch VTIs, IOCs and MITRE ATT&CK for a VMRay sample, run concurrently, assembled into one AnalysisDetails object. Failing sections are reported in `errors` rather than aborting the whole action.",
  "uuid": "df213342-0f35-53ec-8c58-3de15e9bad5d",
  "docker_parameters": "GetAnalysisDetails",
  "arguments": {
    "properties": {
      "sample_id": {
        "description": "VMRay sample_id to fetch details for.",
        "title": "Sample Id",
        "type": "integer"
      },
      "include_vtis": {
        "default": true,
        "title": "Include Vtis",
        "type": "boolean"
      },
      "include_iocs": {
        "default": true,
        "title": "Include Iocs",
        "type": "boolean"
      },
      "include_mitre_attack": {
        "default": true,
        "title": "Include Mitre Attack",
        "type": "boolean"
      },
      "include_recursive": {
        "default": false,
        "description": "Also fetch recursive children's threat_names/classifications (2026.2+ only, costs two extra calls).",
        "title": "Include Recursive",
        "type": "boolean"
      },
      "include_analyses": {
        "default": false,
        "description": "Also fetch per-VM-profile analysis runs (GET /analysis/sample/{id}), costs one extra call.",
        "title": "Include Analyses",
        "type": "boolean"
      },
      "ioc_severity_filter": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Restrict fetched IOCs to this severity server-side (VMRay's documented values: 'malicious' or 'suspicious'). Leave empty to fetch all severities.",
        "title": "Ioc Severity Filter"
      },
      "analysis_verdict_filter": {
        "description": "Only include analysis runs (requires include_analyses) whose analysis_verdict is one of these values (e.g. ['malicious', 'suspicious']). Filtered client-side, after fetch. Empty = no filtering.",
        "items": {
          "type": "string"
        },
        "title": "Analysis Verdict Filter",
        "type": "array"
      }
    },
    "required": [
      "sample_id"
    ],
    "title": "GetAnalysisDetailsArguments",
    "type": "object"
  },
  "results": {
    "$defs": {
      "AnalysisRun": {
        "additionalProperties": true,
        "description": "One entry from GET /analysis/sample/{id} -> a single VM-profile analysis\nrun. A sample can carry several of these (different sandbox profiles/\nplatforms); each has its own verdict, distinct from the aggregate\n`sample_verdict` on the base sample object.",
        "properties": {
          "analysis_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis Id"
          },
          "analysis_verdict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis Verdict"
          },
          "analysis_severity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis Severity"
          },
          "analysis_vti_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis Vti Score"
          },
          "analysis_configuration_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis Configuration Name"
          },
          "analysis_created": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis Created"
          },
          "analysis_job_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis Job Id"
          }
        },
        "title": "AnalysisRun",
        "type": "object"
      },
      "IOCSet": {
        "additionalProperties": true,
        "description": "The `iocs` object from GET /sample/{id}/iocs. Keys per the spec's\ndocumented ioc_type filter values.",
