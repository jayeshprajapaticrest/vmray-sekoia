        "type": "boolean"
      },
      "net_scheme_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Network scheme for the analysis VM (e.g. 'Isolated'), sent via user_config.",
        "title": "Net Scheme Name"
      },
      "analysis_timeout": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Analysis timeout in seconds on the VMRay side, sent via user_config.",
        "title": "Analysis Timeout"
      },
      "max_recursive_samples": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Maximum number of recursive (child) samples VMRay may create and analyse.",
