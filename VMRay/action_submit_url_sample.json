        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Run Reputation Analysis on the sample and its artifacts (hashes and URLs only are sent to third-party services, never the file itself).",
        "title": "Enable Reputation"
      },
      "enable_whois": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
