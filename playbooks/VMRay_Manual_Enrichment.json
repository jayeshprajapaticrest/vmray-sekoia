{
  "name": "VMRay: Enrich alert on demand (hash lookup, URL detonation)",
  "uuid": "0c779e43-fee3-4e15-92de-86ec2c0e177d",
  "tags": [
    "Alerts",
    "Enrichment",
    "VMRay"
  ],
  "nodes": {
    "0": {
      "name": "Manual Trigger",
      "type": "trigger",
      "outputs": {
        "default": [
          "2"
        ]
      },
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
      "trigger_uuid": "fc26eb9f-b272-4c15-b3bf-ace397c0dc57"
    },
    "2": {
      "name": "Get Alert",
      "type": "action",
      "outputs": {
        "default": [
          "3"
        ]
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "stix": false
      },
      "action_uuid": "8d189665-5401-4098-8d60-944de9a6199a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "3": {
      "name": "Get Events",
      "type": "action",
      "outputs": {
        "default": [
          "4"
        ]
      },
      "arguments": {
        "query": "alert_short_ids: \"{{ node.2['short_id'] }}\"",
        "earliest_time": "{{ node.2['first_seen_at'] }}",
        "latest_time": "{{ node.2['last_seen_at'] }}"
      },
      "action_uuid": "af0b4355-a428-43d6-991c-d5ff878e17d5",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "4": {
      "name": "Extract file hashes",
      "type": "action",
      "outputs": {
        "default": [
          "5"
        ]
      },
      "arguments": {
        "file": "{{ node.3['events'] }}",
        "to_file": false,
        "jsonpath": "$..['file.hash.sha256','file.hash.sha1','file.hash.md5','process.hash.sha256','process.hash.sha1','process.hash.md5']",
        "return_list": true
      },
      "action_uuid": "ecedfa52-7033-4ea8-9c3b-93ad34295f87",
      "module_uuid": "07cce76b-a319-40ee-a0cf-1ba433431e21"
    },
    "5": {
      "name": "Extract URLs (url.full)",
      "type": "action",
      "outputs": {
        "default": [
          "6"
        ]
      },
      "arguments": {
        "file": "{{ node.3['events'] }}",
        "to_file": false,
        "jsonpath": "$[?(@['url.full'] =~ '(?i)^https?://')]['url.full']",
        "return_list": true
      },
      "action_uuid": "ecedfa52-7033-4ea8-9c3b-93ad34295f87",
      "module_uuid": "07cce76b-a319-40ee-a0cf-1ba433431e21"
    },
    "6": {
      "name": "Extract URLs (url.original)",
      "type": "action",
      "outputs": {
        "default": [
          "7"
        ]
      },
      "arguments": {
        "file": "{{ node.3['events'] }}",
        "to_file": false,
        "jsonpath": "$[?(@['url.original'] =~ '(?i)^https?://')]['url.original']",
        "return_list": true
      },
      "action_uuid": "ecedfa52-7033-4ea8-9c3b-93ad34295f87",
      "module_uuid": "07cce76b-a319-40ee-a0cf-1ba433431e21"
    },
    "7": {
      "name": "Hash found?",
      "type": "operator",
      "subtype": "condition",
      "cases": [
        {
          "left": "{{ node.4['output'] | length }}",
          "name": "Hash found",
          "right": "{{ 0 }}",
          "comparison": ">",
          "description": "At least one file.hash.* / process.hash.* value in this alert's events"
        }
      ],
      "outputs": {
        "Hash found": [
          "8"
        ],
        "else": [
          "10"
        ]
      }
    },
    "8": {
      "name": "VMRay: Search sample by hash",
      "type": "action",
      "outputs": {
        "found": [
          "9"
        ],
        "not_found": [
          "10"
        ]
      },
      "arguments": {
        "hash": "{{ node.4['output'][0] }}"
      },
      "action_uuid": "294a9ede-a0da-5461-9d0b-d9cb66f928a7",
      "module_uuid": "a250eb2a-058b-4b4c-8b16-220d31ed5e6e"
    },
    "9": {
      "name": "VMRay: Get analysis details",
      "type": "action",
      "outputs": {
        "default": [
          "12"
        ]
      },
      "arguments": {
        "sample_id": "{{ node.8['analysis']['sample_id'] }}",
        "include_vtis": true,
        "include_iocs": true,
        "include_mitre_attack": true,
        "include_analyses": true
      },
      "action_uuid": "df213342-0f35-53ec-8c58-3de15e9bad5d",
      "module_uuid": "a250eb2a-058b-4b4c-8b16-220d31ed5e6e"
    },
    "10": {
      "name": "URL found?",
      "type": "operator",
      "subtype": "condition",
      "cases": [
        {
          "left": "{{ (node.5['output'] + node.6['output']) | length }}",
          "name": "URL found",
          "right": "{{ 0 }}",
          "comparison": ">",
          "description": "At least one http(s) URL in url.full / url.original — reached when there is no hash, or the hash is unknown to VMRay"
        }
      ],
      "outputs": {
        "URL found": [
          "11"
        ],
        "else": [
          "17"
        ]
      }
    },
    "11": {
      "name": "VMRay: Submit URL and enrich",
      "type": "action",
      "outputs": {
        "completed": [
          "12"
        ],
        "timed_out": [
          "18"
        ],
        "submission_failed": [
          "18"
        ],
        "sample_id_missing": [
          "18"
        ]
      },
      "arguments": {
        "sample_url": "{{ (node.5['output'] + node.6['output'])[0] }}",
        "include_vtis": true,
        "include_iocs": true,
        "include_mitre_attack": true,
        "include_analyses": true
      },
      "action_uuid": "6e668214-4db9-55cd-aa9d-13afa2bb86b4",
      "module_uuid": "a250eb2a-058b-4b4c-8b16-220d31ed5e6e"
    },
    "12": {
      "name": "VMRay: Render analysis summary",
      "type": "action",
      "outputs": {
        "default": [
          "13"
        ]
      },
      "arguments": {
        "analysis": "{{ node.9 if (node.9 is defined and node.9) else node.11['analysis'] }}"
      },
      "action_uuid": "54e8dd0c-3cf6-5919-9f63-cbef20ae72f3",
      "module_uuid": "a250eb2a-058b-4b4c-8b16-220d31ed5e6e"
    },
    "13": {
      "name": "Comment Alert",
      "type": "action",
      "outputs": {
        "default": [
          "14"
        ]
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "author": "VMRay",
        "content": "{{ node.12['content'] }}"
      },
      "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "14": {
      "name": "Verdict malicious?",
      "type": "operator",
      "subtype": "condition",
      "cases": [
        {
          "left": "{{ (node.9 if (node.9 is defined and node.9) else node.11['analysis'])['sample_verdict'] }}",
          "name": "Malicious",
          "right": "malicious",
          "comparison": "==",
          "description": "IOC-collection policy: only malicious verdicts are pushed live; suspicious/clean stay comment-only"
        }
      ],
      "outputs": {
        "Malicious": [
          "15"
        ],
        "else": []
      }
    },
    "15": {
      "name": "VMRay: IOCs to indicator list",
      "type": "action",
      "outputs": {
        "default": [
          "16"
        ]
      },
      "arguments": {
        "iocs": "{{ node.9 if (node.9 is defined and node.9) else node.11['analysis'] }}"
      },
      "action_uuid": "31b0878c-1a29-5b5a-bf5a-dc1408808c6e",
      "module_uuid": "a250eb2a-058b-4b4c-8b16-220d31ed5e6e"
    },
    "16": {
      "name": "Add hashes to IOC Collection",
      "type": "action",
      "outputs": {
        "default": []
      },
      "arguments": {
        "indicators": "{{ node.15['indicators'] | selectattr('type', 'equalto', 'hash') | map(attribute='value') | list }}",
        "indicator_type": "hash",
        "ioc_collection_id": "REPLACE_WITH_YOUR_VMRAY_IOC_COLLECTION_ID",
        "valid_for": 30
      },
      "action_uuid": "0acabc04-43b4-4564-b9b2-08b80e0e1ecf",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "17": {
      "name": "Comment Alert (nothing to enrich)",
      "type": "action",
      "outputs": {
        "default": []
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "author": "VMRay",
        "content": "No VMRay enrichment: this alert's events carry no file hash known to VMRay and no http(s) URL to detonate. Fields checked: file.hash.sha256/sha1/md5, process.hash.sha256/sha1/md5, url.full, url.original."
      },
      "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "18": {
      "name": "Comment Alert (detonation incomplete)",
      "type": "action",
      "outputs": {
        "default": []
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "author": "VMRay",
        "content": "VMRay detonation of {{ (node.5['output'] + node.6['output'])[0] }} did not return a result.{% if node.11['timed_out'] %} Timed out waiting — submission {{ node.11['submission_id'] }} may still finish on VMRay.{% endif %}{% if node.11['submission_errors'] %} Submission errors: {{ node.11['submission_errors'] }}{% endif %}"
      },
      "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    }
  },
  "workspace": "Operation Center",
  "description": "Run by an analyst on a single alert. Gets the alert and its events, then extracts a file hash (file.hash.* / process.hash.*, sha256/sha1/md5) and http(s) URLs (url.full, url.original). A hash is looked up in VMRay's existing history first (zero quota); if there is no hash, or VMRay has never seen it, the first URL is detonated (consumes VMRay quota, waits up to 30 min). Either result is rendered as one alert comment; malicious verdicts also push dropped-file hashes to an IOC collection. Before use: replace ioc_collection_id on 'Add hashes to IOC Collection' with a real Sekoia IOC collection UUID."
}
