          "left": "{{ node.13['indicators'] | selectattr('type', 'equalto', 'hash') | list | length }}",
          "name": "Yes",
          "right": "{{ 0 }}",
          "comparison": ">",
          "description": "Only malicious samples yield indicators (ReportToIndicators default) — skip the push when there are none"
