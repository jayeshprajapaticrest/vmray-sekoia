      "trigger_uuid": "fc26eb9f-b272-4c15-b3bf-ace397c0dc57"
    },
    "2": {
      "name": "Get Alert",
      "type": "action",
      "outputs": {
        "default": [
          "3"
        ]
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "stix": false
      },
      "action_uuid": "8d189665-5401-4098-8d60-944de9a6199a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "3": {
      "name": "Get Events",
      "type": "action",
      "outputs": {
        "default": [
          "4"
        ]
      },
      "arguments": {
        "query": "alert_short_ids: \"{{ node.2['short_id'] }}\"",
        "earliest_time": "{{ node.2['first_seen_at'] }}",
        "latest_time": "{{ node.2['last_seen_at'] }}"
      },
      "action_uuid": "af0b4355-a428-43d6-991c-d5ff878e17d5",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "4": {
      "name": "Extract file hashes",
      "type": "action",
      "outputs": {
        "default": [
          "5"
        ]
      },
      "arguments": {
        "file": "{{ node.3['events'] }}",
        "to_file": false,
        "jsonpath": "$..['file.hash.sha256','file.hash.sha1','file.hash.md5','process.hash.sha256','process.hash.sha1','process.hash.md5']",
        "return_list": true
      },
      "action_uuid": "ecedfa52-7033-4ea8-9c3b-93ad34295f87",
      "module_uuid": "07cce76b-a319-40ee-a0cf-1ba433431e21"
    },
    "5": {
      "name": "Extract URLs (url.full)",
      "type": "action",
      "outputs": {
        "default": [
          "6"
        ]
      },
      "arguments": {
        "file": "{{ node.3['events'] }}",
        "to_file": false,
        "jsonpath": "$[?(@['url.full'] =~ '(?i)^https?://')]['url.full']",
        "return_list": true
      },
      "action_uuid": "ecedfa52-7033-4ea8-9c3b-93ad34295f87",
      "module_uuid": "07cce76b-a319-40ee-a0cf-1ba433431e21"
    },
    "6": {
      "name": "Extract URLs (url.original)",
      "type": "action",
      "outputs": {
        "default": [
          "7",
          "8",
          "16"
        ]
      },
      "arguments": {
        "file": "{{ node.3['events'] }}",
        "to_file": false,
        "jsonpath": "$[?(@['url.original'] =~ '(?i)^https?://')]['url.original']",
        "return_list": true
      },
      "action_uuid": "ecedfa52-7033-4ea8-9c3b-93ad34295f87",
      "module_uuid": "07cce76b-a319-40ee-a0cf-1ba433431e21"
    },
    "7": {
      "name": "Nothing to enrich?",
      "type": "operator",
      "subtype": "condition",
      "cases": [
        {
          "left": "{{ (node.4['output'] + node.5['output'] + node.6['output']) | length }}",
          "name": "Nothing",
          "right": "{{ 0 }}",
          "comparison": "==",
          "description": "No hash and no http(s) URL at all — the hash and URL branches both stop silently, so say so once"
        }
      ],
      "outputs": {
        "Nothing": [
          "25"
        ],
        "else": []
      }
    },
    "8": {
      "name": "Hash found?",
      "type": "operator",
      "subtype": "condition",
      "cases": [
        {
          "left": "{{ node.4['output'] | length }}",
          "name": "Yes",
          "right": "{{ 0 }}",
          "comparison": ">",
          "description": "At least one file/process hash in the events"
        }
      ],
      "outputs": {
        "Yes": [
          "9"
        ],
        "else": []
      }
    },
    "9": {
      "name": "VMRay: Get samples by hash",
      "type": "action",
      "outputs": {
        "found": [
