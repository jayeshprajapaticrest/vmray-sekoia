{
  "name": "VMRay: Check hash on manual trigger",
  "uuid": "b8297fa2-70a6-4b34-965f-5df229510075",
  "tags": [
    "Alerts",
    "Enrichment",
    "VMRay"
  ],
  "nodes": {
    "0": {
      "name": "Manual Trigger",
      "type": "trigger",
      "outputs": {
        "default": ["1"]
      },
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a",
      "trigger_uuid": "fc26eb9f-b272-4c15-b3bf-ace397c0dc57"
    },
    "1": {
      "name": "Get Alert",
      "type": "action",
      "outputs": {
        "default": ["2"]
      },
      "arguments": {
        "stix": false,
        "uuid": "{{ node.0['alert_uuid'] }}"
      },
      "action_uuid": "8d189665-5401-4098-8d60-944de9a6199a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "2": {
      "name": "Get Events",
      "type": "action",
      "outputs": {
        "default": ["3"]
      },
      "arguments": {
        "query": "alert_short_ids: \"{{ node.1['short_id'] }}\"",
        "earliest_time": "{{ node.1['first_seen_at'] }}",
        "latest_time": "{{ node.1['last_seen_at'] }}"
      },
      "action_uuid": "af0b4355-a428-43d6-991c-d5ff878e17d5",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "3": {
      "name": "Extract file hash",
      "type": "action",
      "outputs": {
        "default": ["4"]
      },
      "arguments": {
        "file": "{{ node.2['events'] }}",
        "to_file": false,
        "jsonpath": "$..[\"file.hash.sha256\"]",
        "return_list": true
      },
      "action_uuid": "ecedfa52-7033-4ea8-9c3b-93ad34295f87",
      "module_uuid": "07cce76b-a319-40ee-a0cf-1ba433431e21"
    },
    "4": {
      "name": "Hash extracted?",
      "type": "operator",
      "subtype": "condition",
      "cases": [
        {
          "left": "{{ node.3['output'] | length }}",
          "name": "Hash found",
          "right": "{{ 0 }}",
          "comparison": ">",
          "description": "At least one file.hash.sha256 present in this alert's events"
        }
      ],
      "outputs": {
        "Hash found": ["5"],
        "else": ["11"]
      }
    },
    "5": {
      "name": "VMRay: Search sample by hash",
      "type": "action",
      "outputs": {
        "found": ["6"],
        "not_found": ["11"]
      },
      "arguments": {
        "hash": "{{ node.3['output'][0] }}"
      },
      "action_uuid": "294a9ede-a0da-5461-9d0b-d9cb66f928a7",
      "module_uuid": "a250eb2a-058b-4b4c-8b16-220d31ed5e6e"
    },
    "6": {
      "name": "VMRay: Get analysis details",
      "type": "action",
      "outputs": {
        "default": ["7"]
      },
      "arguments": {
        "sample_id": "{{ node.5['analysis']['sample_id'] }}",
        "include_vtis": true,
        "include_iocs": true,
        "include_mitre_attack": true,
        "include_recursive": false
      },
      "action_uuid": "df213342-0f35-53ec-8c58-3de15e9bad5d",
      "module_uuid": "a250eb2a-058b-4b4c-8b16-220d31ed5e6e"
    },
    "7": {
      "name": "VMRay: Render analysis summary",
      "type": "action",
      "outputs": {
        "default": ["8"]
      },
      "arguments": {
        "analysis": "{{ node.6 }}"
      },
      "action_uuid": "54e8dd0c-3cf6-5919-9f63-cbef20ae72f3",
      "module_uuid": "a250eb2a-058b-4b4c-8b16-220d31ed5e6e"
    },
    "8": {
      "name": "Comment Alert",
      "type": "action",
      "outputs": {
        "default": ["9"]
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "author": "VMRay",
        "content": "{{ node.7['content'] }}"
      },
      "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "9": {
      "name": "VMRay: IOCs to indicator list",
      "type": "action",
      "outputs": {
        "default": ["10"]
      },
      "arguments": {
        "iocs": "{{ node.6 }}"
      },
      "action_uuid": "31b0878c-1a29-5b5a-bf5a-dc1408808c6e",
      "module_uuid": "a250eb2a-058b-4b4c-8b16-220d31ed5e6e"
    },
    "10": {
      "name": "Add sample hash to IOC Collection",
      "type": "action",
      "outputs": {
        "default": []
      },
      "arguments": {
        "indicators": "{{ node.9['indicators'] | selectattr('type', 'equalto', 'hash') | map(attribute='value') | list }}",
        "indicator_type": "hash",
        "ioc_collection_id": "REPLACE_WITH_YOUR_VMRAY_IOC_COLLECTION_ID",
        "valid_for": 30
      },
      "action_uuid": "0acabc04-43b4-4564-b9b2-08b80e0e1ecf",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    },
    "11": {
      "name": "Comment Alert (no VMRay match)",
      "type": "action",
      "outputs": {
        "default": []
      },
      "arguments": {
        "uuid": "{{ node.0['alert_uuid'] }}",
        "author": "VMRay",
        "content": "No file hash observable found in this alert's events, or the hash is not known to VMRay. This playbook only checks VMRay's existing history (zero quota cost) — it does not submit a fresh sample from a hash alone. To detonate a URL or file, use the VMRay module's Submit and enrich action directly."
      },
      "action_uuid": "0d323de3-a864-4afe-a0c3-e7ff45883d7a",
      "module_uuid": "92d8bb47-7c51-445d-81de-ae04edbb6f0a"
    }
  },
  "workspace": "Operation Center",
  "description": "Manual-trigger enrichment: extracts a file.hash.sha256 from the alert's events, looks it up against VMRay's existing analysis history (zero quota cost), and if found, fetches full VTIs/IOCs/MITRE ATT&CK, comments the alert with a summary, and pushes the sample hash to an IOC collection. Does not submit a fresh detonation from a hash alone (VMRay cannot analyse a hash it hasn't already seen) — before use, replace ioc_collection_id on the 'Add sample hash to IOC Collection' node with a real Sekoia IOC collection UUID."
}
